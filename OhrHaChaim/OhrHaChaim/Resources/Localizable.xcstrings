    "about.author": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רבי חיים בן משה אבן עטר (תנ״ו–תק״ג, 1696–1743), מחכמי סלא שבמרוקו ומירושלים, מחבר פירוש אור החיים על התורה. הפירוש משלב פשט, דרש וקבלה. הוא עלה לירושלים ובה נפטר."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabbi Chaim ben Moshe ibn Attar (1696–1743), of Salé in Morocco and of Jerusalem, wrote Ohr HaChaim on the Torah. The commentary joins peshat, derash, and kabbalah. He settled in Jerusalem and died there."
          }
        }
      }
    },
    "about.sourcesHeading": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקורות ורישיונות"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources and licences"
          }
        }
      }
    },
    "about.sources": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוסח הפירוש: Sefaria Vocalized Edition, עברית, על בראשית, שמות, ויקרא, במדבר ודברים. רישיון CC0 1.0 (נחלת הכלל). https://www.sefaria.org\n\nהקדמת המחבר: הגרסה העברית ששמה המדויק הוא On Your Way, רשות הציבור (Public Domain), כפי שפורסמה בספריא. לא נעשה שימוש בגרסה ששמה מסתיים ברווח, מפני שרישיונה אינו ידוע.\n\nלוח הפרשות, כולל פרשות מחוברות וההבדל בין ישראל לחוץ לארץ: Hebcal.com, ברישיון Creative Commons Attribution 4.0 (CC BY 4.0). יש לייחס את לוח הקריאה ל־Hebcal.com. https://www.hebcal.com\n\nהגופן: Noto Serif Hebrew, © 2022 The Noto Project Authors, SIL Open Font License 1.1.\n\nהטקסט באפליקציה הוא עברית בלבד. אין בה תרגום של הפירוש."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commentary text: Sefaria Vocalized Edition, Hebrew, on Genesis, Exodus, Leviticus, Numbers, and Deuteronomy. Licence CC0 1.0. https://www.sefaria.org\n\nAuthor's introduction: the Hebrew version whose exact title is On Your Way, public domain, as published on Sefaria. The version whose title ends with a space was not used, because its licence is unknown.\n\nTorah-reading calendar, including combined portions and the Israel / Diaspora difference: Hebcal.com, under Creative Commons Attribution 4.0 (CC BY 4.0). Attribute the schedule to Hebcal.com. https://www.hebcal.com\n\nTypeface: Noto Serif Hebrew, © 2022 The Noto Project Authors, SIL Open Font License 1.1.\n\nThe text in the app is Hebrew only. The commentary is not translated."
          }
        }
      }
    },
    "about.offline": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה אינה מתחברת לרשת ואינה אוספת מידע. קישור מדיניות הפרטיות נפתח בדפדפן."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not connect to the network and does not collect information. The privacy-policy link opens in the browser."
          }
        }
      }
    },
